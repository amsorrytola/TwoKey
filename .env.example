# Groq — free tier. Two keys so the mesh has 2x the tokens-per-minute budget.
GROQ_API_KEY_PRIMARY=gsk_...
GROQ_API_KEY_SECONDARY=gsk_...

# DeepSeek — the SECOND KEY of the Two-Key lane. A different vendor on separate
# infrastructure, so one bad model or one leaked credential cannot turn both keys.
# Optional: without it the second key falls back to a different Groq model family.
DEEPSEEK_API_KEY=sk-...
